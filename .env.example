# ───── 資料庫 ─────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/szm_dev?schema=public"
# 整合測試用（測試會清空此資料庫，請勿指向正式資料庫）
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/szm_test?schema=public"

# ───── 網站 ─────
# 對外網址（Email 中之案件連結使用）
APP_URL="http://localhost:3000"
# 工作階段權杖 HMAC 金鑰，至少 32 字元：openssl rand -base64 48
SESSION_SECRET=""
# 工作階段有效時數（滑動延長）
SESSION_MAX_AGE_HOURS=12
# 敏感欄位（附件下載密碼）加密金鑰，32 bytes base64：openssl rand -base64 32
# 設定後請勿更換，否則既有資料無法解密
DATA_ENCRYPTION_KEY=""
# 公文抬頭之公司名稱
COMPANY_NAME="○○交通工程顧問有限公司"

# ───── 排程 ─────
# 外部呼叫 POST /api/cron/daily-reminders 時之 Bearer 權杖
CRON_SECRET=""
# 非工作天是否略過每日提醒（亦可於系統設定頁調整）
REMINDER_SKIP_NON_BUSINESS_DAYS=true

# ───── Email ─────
# resend | smtp | console（console 僅寫入日誌，不實際寄出）
EMAIL_PROVIDER="console"
EMAIL_FROM="通學區案件系統 <no-reply@your-domain.tw>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
# 測試模式：所有提醒改寄測試收件人（預設開啟；可於系統設定頁切換）
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT="you@your-domain.tw"

# ───── PDF ─────
# 中文字型路徑（Docker 映像檔已內建文泉驛正黑）
PDF_FONT_PATH=""
PDF_FONT_FAMILY=""

# ───── 初始管理員（npm run db:seed 或 Docker 啟動時建立；建立後可移除）─────
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
INITIAL_ADMIN_NAME="系統管理員"

LOG_LEVEL=info
