# ============================================================
# 前端（Cloudflare Pages / 本機 Vite）— 這些值會公開在瀏覽器中
# 只能放「公開」金鑰。絕對不要放 service_role / secret key / VAPID 私鑰
# ============================================================
# Supabase 專案網址：Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase 公開金鑰：Project Settings → API Keys → Publishable key（sb_publishable_...）
# 或舊版 anon public key（eyJ... 且 role=anon）
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# 網站正式網址（密碼重設信的導回位址）
VITE_SITE_URL=http://localhost:5173

# ============================================================
# 本機 RLS 測試（scripts/local-db.sh 會啟動的本機 PostgreSQL）
# ============================================================
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/calendar_test
