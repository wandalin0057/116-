{
  "name": "deadline-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "個人專案行事曆暨工作期限提醒系統（多使用者 SaaS）",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:all": "vitest run",
    "db:local:up": "bash scripts/local-db.sh up",
    "db:local:down": "bash scripts/local-db.sh down",
    "db:local:reset": "bash scripts/local-db.sh reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.75.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "pg": "8.16.3",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
